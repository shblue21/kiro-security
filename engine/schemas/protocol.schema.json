{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiro-security-power.invalid/schemas/protocol.schema.json",
  "title": "Kiro Security Power JSON-RPC envelope",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/notification" }
  ],
  "$defs": {
    "version": { "const": "1.0" },
    "eventName": {
      "enum": ["engine.ready", "scan.started", "scan.phaseChanged", "scan.progress", "finding.discovered", "finding.updated", "artifact.created", "scan.completed", "scan.cancelled", "scan.failed", "scan.integrityIssue", "engine.log"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "protocolVersion", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "id": { "type": "integer" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "not": {
        "properties": { "method": { "$ref": "#/$defs/eventName" } },
        "required": ["method"]
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "protocolVersion", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "id": { "type": ["integer", "null"] },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": { "type": "object" } }
        }
      },
      "oneOf": [
        {
          "required": ["result"],
          "properties": { "id": { "type": "integer" } },
          "not": { "required": ["error"] }
        },
        {
          "required": ["error"],
          "not": { "required": ["result"] },
          "oneOf": [
            { "properties": { "id": { "type": "integer" } } },
            {
              "properties": {
                "id": { "type": "null" },
                "error": {
                  "type": "object",
                  "properties": { "code": { "enum": [-32700, -32600] } },
                  "required": ["code"]
                }
              }
            }
          ]
        }
      ]
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "protocolVersion", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "method": { "$ref": "#/$defs/eventName" },
        "params": { "type": "object" }
      }
    }
  }
}
