{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiro-security-power.invalid/schemas/coverage.schema.json",
  "title": "Kiro Security Power row-receipt coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "scanId",
    "mode",
    "completeness",
    "inventoryStrategy",
    "includePaths",
    "excludePaths",
    "supportedFileCount",
    "inScopeRowCount",
    "closedRowCount",
    "deepStatus",
    "surfaces",
    "unclosedRows",
    "explicitExclusions",
    "deferred",
    "openQuestions"
  ],
  "properties": {
    "documentType": { "const": "kiro-security-power.coverage" },
    "schemaVersion": { "const": "1.0" },
    "scanId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mode": {
      "enum": ["repository", "scoped_path", "diff", "commit", "branch_diff", "working_tree", "deep_repository"]
    },
    "completeness": { "enum": ["complete", "partial", "unknown"] },
    "inventoryStrategy": { "enum": ["repository", "scoped_path", "diff", "directory", "custom"] },
    "includePaths": { "type": "array", "items": { "type": "string" } },
    "excludePaths": { "type": "array", "items": { "type": "string" } },
    "supportedFileCount": { "type": "integer", "minimum": 0 },
    "inScopeRowCount": { "type": "integer", "minimum": 0 },
    "closedRowCount": { "type": "integer", "minimum": 0 },
    "deepStatus": {
      "type": ["string", "null"],
      "enum": [null, "awaiting_workers", "awaiting_merge", "saturated", "capped"]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rowId",
          "path",
          "label",
          "surface",
          "disposition",
          "reason",
          "receiptDigest",
          "receiptRefs",
          "evidenceRefs",
          "candidateIds",
          "workerId"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rowId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "label": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "surface": { "type": "string", "minLength": 1, "maxLength": 512 },
          "entrypoint": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "rootControl": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "sink": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "disposition": { "enum": ["reportable", "suppressed", "not_applicable", "deferred"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "receiptRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "candidateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "workerId": { "type": ["string", "null"] }
        }
      }
    },
    "unclosedRows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rowId", "path", "surface", "reason"],
        "properties": {
          "rowId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "explicitExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rowId", "path", "reason", "receiptDigest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rowId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "followUpPrompt": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "completeness": { "const": "complete" } }, "required": ["completeness"] },
      "then": {
        "properties": {
          "supportedFileCount": { "minimum": 1 },
          "deferred": { "maxItems": 0 },
          "unclosedRows": { "maxItems": 0 },
          "surfaces": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "disposition": { "const": "deferred" } },
                "required": ["disposition"]
              }
            }
          },
          "deepStatus": { "not": { "const": "capped" } }
        }
      }
    }
  ]
}
