{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiro-security-power.invalid/schemas/scan-manifest.schema.json",
  "title": "Kiro Security Power completed scan manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "scan"],
  "properties": {
    "documentType": { "const": "kiro-security-power.scan-manifest" },
    "schemaVersion": { "const": "1.0" },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "producer",
        "status",
        "startedAt",
        "completedAt",
        "sealedAt",
        "target",
        "scope",
        "threatModel",
        "hardening",
        "coverageRef",
        "findingsRef",
        "artifacts",
        "derivedArtifacts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^scan_[a-f0-9]{24}$" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "kiro-security-power" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "status": { "const": "completed" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "sealedAt": { "type": "string", "format": "date-time" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "targetId", "displayName", "revision", "baseRevision", "headRevision", "snapshotDigest"],
          "properties": {
            "kind": { "enum": ["git_revision", "git_worktree", "git_diff", "directory_snapshot"] },
            "targetId": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "revision": { "type": ["string", "null"] },
            "baseRevision": { "type": ["string", "null"] },
            "headRevision": { "type": ["string", "null"] },
            "snapshotDigest": { "type": ["string", "null"] }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["includePaths", "excludePaths", "summary", "artifactsReviewed", "runtimeStatus", "validationMode", "limitations"],
          "properties": {
            "includePaths": { "type": "array", "items": { "type": "string" } },
            "excludePaths": { "type": "array", "items": { "type": "string" } },
            "summary": { "type": "string", "minLength": 1 },
            "artifactsReviewed": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "runtimeStatus": { "enum": ["static-only", "agent-assisted-static"] },
            "validationMode": {
              "enum": [
                "deterministic-static-analysis",
                "deterministic-diff-static-analysis",
                "agent-assisted-discovery+deterministic-static-validation",
                "agent-assisted-discovery+model-validation"
              ]
            },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "threatModel": {
          "type": "object",
          "additionalProperties": true,
          "required": ["summary"]
        },
        "hardening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portfolioPath"],
          "properties": {
            "portfolioPath": { "const": "hardening/hardening.md" }
          }
        },
        "coverageRef": { "const": "coverage.json" },
        "findingsRef": { "const": "findings.json" },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "mediaType", "role"],
            "properties": {
              "path": { "$ref": "#/$defs/safeRelativePath" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "mediaType": { "type": "string", "minLength": 1 },
              "role": { "enum": ["canonical", "supporting"] }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "path": { "const": "coverage.json" } },
                "required": ["path"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "path": { "const": "findings.json" } },
                "required": ["path"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "derivedArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mediaType", "generatedFrom"],
            "properties": {
              "path": { "$ref": "#/$defs/safeRelativePath" },
              "mediaType": { "type": "string", "minLength": 1 },
              "generatedFrom": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/safeRelativePath" } },
              "findingId": { "type": "string", "pattern": "^kspf_[a-f0-9]{24}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\x00).+$"
    }
  }
}
