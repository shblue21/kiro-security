{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiro-security-power.invalid/schemas/findings.schema.json",
  "title": "Kiro Security Power findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "scanId", "findings"],
  "properties": {
    "documentType": { "const": "kiro-security-power.findings" },
    "schemaVersion": { "const": "1.0" },
    "scanId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "maxLength": 128 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "path", "startLine", "code", "explanation"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "language": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "code": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId", "occurrenceId", "ruleId", "identity", "fingerprints", "title", "summary",
        "severity", "confidence", "taxonomy", "locations", "remediation", "provenance"
      ],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "occurrenceId": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor"],
          "properties": {
            "anchor": { "type": "string", "minLength": 1 },
            "instance": { "type": ["string", "null"] }
          }
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "primary"],
          "properties": {
            "algorithm": { "enum": ["kiro-security/v1", "kiro-security/deep-v1"] },
            "primary": { "type": "string", "pattern": "^kiro-security/(?:deep-)?v1:sha256:[a-f0-9]{64}$" }
          }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "severity": {
          "type": "object",
          "additionalProperties": true,
          "required": ["level"],
          "properties": {
            "level": { "enum": ["critical", "high", "medium", "low", "informational"] },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "scoringSystem": { "type": ["string", "null"] },
            "vector": { "type": ["string", "null"] },
            "rationale": { "type": ["string", "null"] },
            "changeConditions": { "type": ["string", "null"] }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": true,
          "required": ["level", "rationale"],
          "properties": {
            "level": { "enum": ["high", "medium", "low"] },
            "rationale": { "type": "string" }
          }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "cwe"],
          "properties": {
            "category": { "type": "string" },
            "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } }
          }
        },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "writeup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reportPath"],
          "properties": { "reportPath": { "type": "string" } }
        },
        "codeEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "rootCause": { "type": ["object", "string"], "additionalProperties": true },
        "remediation": { "type": "string", "minLength": 1 },
        "validation": { "type": ["object", "null"], "additionalProperties": true },
        "attackPath": { "type": ["object", "null"], "additionalProperties": true },
        "remediationTests": { "type": "array", "items": { "type": "string" } },
        "preventiveControls": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "required": ["source"],
          "properties": { "source": { "const": "kiro_security_power" } }
        },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
