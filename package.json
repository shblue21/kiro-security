{
  "name": "kiro-security-power",
  "displayName": "Kiro Security Power",
  "description": "A Kiro-native security workbench rebuilt from the Codex Security 0.1.11 architecture.",
  "version": "0.1.0",
  "publisher": "kiro-security-power",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:kiroSecurity.setup",
    "onCommand:kiroSecurity.openSetup",
    "onCommand:kiroSecurity.showFoundationStatus",
    "onCommand:kiroSecurity.preparePowerIntegration"
  ],
  "main": "./out/packages/extension/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiroSecurity",
          "title": "Kiro Security",
          "icon": "media/security.svg"
        }
      ]
    },
    "views": {
      "kiroSecurity": [
        {
          "id": "kiroSecurity.setup",
          "name": "Kiro Security Power",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "kiroSecurity.openSetup",
        "title": "Kiro Security: Open Setup"
      },
      {
        "command": "kiroSecurity.showFoundationStatus",
        "title": "Kiro Security: Show Foundation Status"
      },
      {
        "command": "kiroSecurity.preparePowerIntegration",
        "title": "Kiro Security: Prepare Power Integration"
      }
    ],
    "configuration": {
      "title": "Kiro Security",
      "properties": {
        "kiroSecurity.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a Python 3.9+ executable used by the Kiro Security Power MCP server."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package:list": "vsce ls",
    "package:vsix": "npm run clean && npm run compile && node scripts/prepare-dist.mjs && vsce package --allow-missing-repository --out dist/kiro-security-power.vsix",
    "test:node": "node --test tests/foundation.test.mjs",
    "test:python": "python3 -m unittest discover -s engine/tests -v",
    "test": "npm run clean && npm run compile && npm run lint && npm run test:node && npm run test:python && npm run package:list"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.0"
  }
}
