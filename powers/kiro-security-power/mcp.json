{
  "mcpServers": {
    "kiro-security-workbench": {
      "command": "python3",
      "args": [
        "-B",
        "-S",
        "-m",
        "kiro_security.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${KIRO_SECURITY_ENGINE_ROOT}",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "KIRO_SECURITY_STATE_ROOT": "${KIRO_SECURITY_STATE_ROOT}",
        "KIRO_SECURITY_SCAN_ROOT": "${KIRO_SECURITY_SCAN_ROOT}"
      },
      "timeout": 900000,
      "disabled": false,
      "autoApprove": [
        "kiro_security_get_capabilities",
        "kiro_security_get_workspace",
        "kiro_security_get_scan_context"
      ]
    }
  }
}
